# Optional defaults. Copy to .env in this workbench directory only.
# npm run dev / npm start load supported fields; process environment wins.
# Model connections saved in the UI take priority over these defaults.
LLM_BACKEND=openai
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# auto: use an explicit HTTP(S) proxy if supplied; otherwise bounded direct access.
# direct: ignore inherited proxies in this backend process.
ZHICUI_NETWORK_MODE=auto
# Optional HTTP proxy reachable from the computer running the backend:
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1,::1

# Default data directory: .data/ in this workbench installation.
# ZHICUI_DATA_DIR=./.data
# Workbench origin only; this does not enable public or multi-user access.
# ZHICUI_PUBLIC_URL=http://127.0.0.1:3000

# Optional PubMed identification / authorized NCBI key.
# NCBI_EMAIL=
# NCBI_API_KEY=
