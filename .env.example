# 可选配置：复制为工作台目录下的 .env（与 package.json 同目录）。
# 已有 .env 时请直接修改，不覆盖原文件。完整步骤见 README 的“代理怎么配置”。
# npm run dev / npm start 在启动时读取；修改后需重启，刷新网页不会生效。
# 已有终端环境变量优先；在界面保存的模型连接优先于这里的模型默认值。
LLM_BACKEND=openai
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# auto：填写 HTTP(S) 代理后使用代理；没有填写时限时直连。
# direct：本次后端明确直连，忽略继承的代理。
ZHICUI_NETWORK_MODE=auto
# 需要代理时，先启动自己的代理软件，并去掉下面三行开头的 #。
# 7897 只是示例，请替换为代理软件实际的 HTTP 或 Mixed 端口。
# 127.0.0.1 指运行工作台的这台电脑。不要填写 socks5:// 地址。
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1
# 注意：git clone / npm ci 不读此文件，安装联网请按 README 设置终端代理。

# Default data directory: .data/ in this workbench installation.
# ZHICUI_DATA_DIR=./.data
# Workbench origin only; this does not enable public or multi-user access.
# ZHICUI_PUBLIC_URL=http://127.0.0.1:3000

# Optional PubMed identification / authorized NCBI key.
# NCBI_EMAIL=
# NCBI_API_KEY=
